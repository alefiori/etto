{
  "name": "macrotrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:legal && vite",
    "build": "npm run build:legal && tsc -b && vite build",
    "build:native": "npm run build:legal && tsc -b && vite build --mode native",
    "build:legal": "node scripts/build-legal.mjs",
    "data:reference": "node scripts/build-reference-foods.mjs",
    "data:reference:check": "node scripts/build-reference-foods.mjs --check",
    "data:reference:import": "node scripts/import-reference-foods.mjs",
    "sync:native": "npm run build:native && cap sync && node scripts/generate-native-icons.mjs && node scripts/patch-android-webview.mjs && node scripts/patch-android-manifest.mjs && node scripts/patch-android-notification-icon.mjs && node scripts/patch-ios-project.mjs && node scripts/verify-ipad.mjs",
    "verify:ipad": "node scripts/verify-ipad.mjs",
    "verify:precache": "node scripts/verify-precache.mjs",
    "verify:budget": "node scripts/verify-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "store:screenshots": "playwright test --config playwright.store.config.ts",
    "store:assets": "node scripts/generate-store-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "@revenuecat/purchases-js": "^1.52.0",
    "@supabase/supabase-js": "^2.112.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "exceljs": "^4.4.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
