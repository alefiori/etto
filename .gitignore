# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-ssr
*.local
*.tsbuildinfo

# Legal documents rendered from legal/*.html by scripts/build-legal.mjs. The
# sources are checked in; the output carries the build's contact address, which
# must not be committed.
/public/legal

# env — never commit secrets
.env
.env.*
!.env.example
# .env.test holds only non-secret stub values for the hermetic E2E build.
!.env.test

# test output
coverage
playwright-report
test-results
blob-report
/playwright/.cache

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# logs
logs

# supabase CLI local state (credentials cache, not source)
supabase/.temp

# Capacitor native projects. Generated by `pnpm exec cap add ios|android`; the
# generated source is checked in only if you need to hand-edit it.
/ios
/android
.gradle
Pods
DerivedData

# Store screenshots are build artifacts of the current UI, regenerated by
# `pnpm run store:screenshots`.
/store/screenshots

# Listing graphics rendered from assets/ by `pnpm run store:assets`.
/store/assets

# Open Graph / Twitter Card preview, rendered from design/logo-concepts by
# `node scripts/generate-og-image.mjs`.
/public/og-image.png

# Cached upstream pages for scripts/build-reference-foods.mjs (re-fetchable).
data/reference/.cache/

# Claude Code agent worktrees — full copies of this tree for background
# agents, nested under the repo by the harness. Not ours to track; .claude/
# itself still carries real project files (skills/), so only this subpath.
.claude/worktrees/
